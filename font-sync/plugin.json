{
  "id": "com.fontmanager.font-sync",
  "name": "字体库同步（GitHub）",
  "version": "0.1.1",
  "apiLevel": 1,
  "entry": "main.py",
  "interpreter": "python",
  "description": "把字体库按字族打包，增量同步到**你自己的**私有 GitHub 仓库（可保存多个账号、切换多个库）；没配好账号与库之前不会同步任何内容；只传变化的字族。零第三方依赖",
  "permissions": [
    "read:fonts"
  ],
  "hooks": [
    "init",
    "context-menu",
    "settings"
  ],
  "menus": [
    {
      "title": "同步这个字族到 GitHub",
      "on": "family"
    },
    {
      "title": "立即同步（全部）",
      "on": "plugin"
    },
    {
      "title": "预演本次同步（不传）",
      "on": "plugin"
    },
    {
      "title": "设置 GitHub 库…",
      "on": "plugin"
    },
    {
      "title": "打开同步状态目录",
      "on": "plugin"
    }
  ],
  "settings": {
    "title": "字体库同步 · 设置 GitHub 库",
    "hook": "settings"
  }
}
