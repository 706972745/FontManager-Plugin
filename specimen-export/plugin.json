{
  "id": "com.fontmanager.example.specimen-export",
  "name": "示例文本导出",
  "version": "1.2.0",
  "apiLevel": 1,
  "entry": "main.py",
  "interpreter": "python",
  "description": "右键字族 → 把示例文本导出成 PNG（保存位置可自己设）；启动时自动跑一遍 API / 权限自检。自带 Python 运行时（runtime/），机器上不用装任何东西",
  "permissions": [
    "read:fonts",
    "read:curation",
    "write:curation"
  ],
  "hooks": [
    "init",
    "context-menu",
    "settings"
  ],
  "menus": [
    {
      "title": "导出示例图（PNG）",
      "on": "family"
    },
    {
      "title": "设置导出位置…",
      "on": "plugin"
    },
    {
      "title": "打开导出文件夹",
      "on": "plugin"
    }
  ],
  "interpreterPath": "runtime/python.exe",
  "settings": {
    "title": "示例文本导出 · 设置",
    "hook": "settings"
  }
}
